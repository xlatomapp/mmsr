        :0!select
            metricValue: avg metricValue,
            horizon_sort_order: first horizon_sort_order,
            positive_reversion_ratio: avg positive_reversion_ratio,
            trade_count: sum trade_count,
            notional: sum notional,
            valid_primary_quote_ratio: avg valid_primary_quote_ratio
        by date, timeBucket, venue, horizon from factsWithMetric
        ];
    if[scope = `topix_cap_group;
        :0!select
            metricValue: avg metricValue,
            horizon_sort_order: first horizon_sort_order,
            positive_reversion_ratio: avg positive_reversion_ratio,
            trade_count: sum trade_count,
            notional: sum notional,
            valid_primary_quote_ratio: avg valid_primary_quote_ratio
        by date, venue, horizon, topixCapGrp from factsWithMetric
        ];
    if[scope = `topix_cap_group_bucket;
        :0!select
            metricValue: avg metricValue,
            horizon_sort_order: first horizon_sort_order,
            positive_reversion_ratio: avg positive_reversion_ratio,
            trade_count: sum trade_count,
            notional: sum notional,
            valid_primary_quote_ratio: avg valid_primary_quote_ratio
        by date, timeBucket, venue, horizon, topixCapGrp from factsWithMetric
        ];
    if[scope = `symbol;
        :0!select
            metricValue: avg metricValue,
            horizon_sort_order: first horizon_sort_order,
            positive_reversion_ratio: avg positive_reversion_ratio,
