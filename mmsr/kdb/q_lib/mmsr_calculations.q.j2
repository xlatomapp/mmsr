/ MMSR reusable q calculation library.
/ Render and install this once into the configured calculation namespace before
/ running metric calculations. All MMSR-owned q functions live in this file.

{{ calculation_namespace }}.partedSym:{[t]
    / Reversion aj paths are day-scoped in production. After xasc by the aj
    / grouping keys, sym is contiguous within the quote/trade search path, so
    / g# lets aj use grouped symbol lookup instead of repeated full scans.
    $[`sym in cols t; @[t;`sym;{`g#x}]; t]
    };

{{ calculation_namespace }}.venueSymKey:{[sym;venue]
    `$ {x,".",y}'[string sym; string venue]
    };

/ flip to table
{{ calculation_namespace }}.metricAggSpec:
    flip flip raze enlist each (
        `metric`level`sourceTable`dependsOn`groupBy`aggExpr`weightCol`filterExpr`outputCol`enabled`version!
            (`turnover;`intraday;`trades_raw;`tradePrice`tradeSize;`date`timeBucket`sym`topixCapGrp;`sum;`;"";`turnover;1b;`v1);
        `metric`level`sourceTable`dependsOn`groupBy`aggExpr`weightCol`filterExpr`outputCol`enabled`version!
            (`turnover;`daily;`trades_raw;`tradePrice`tradeSize;`date`sym`topixCapGrp;`sum;`;"";`turnover;1b;`v1);
        `metric`level`sourceTable`dependsOn`groupBy`aggExpr`weightCol`filterExpr`outputCol`enabled`version!
            (`turnover;`weekly;`turnover_daily;`turnover;`year`week`topixCapGrp;`mean;`;"";`turnover;1b;`v1);
        `metric`level`sourceTable`dependsOn`groupBy`aggExpr`weightCol`filterExpr`outputCol`enabled`version!
            (`turnover;`monthly;`turnover_daily;`turnover;`year`month`topixCapGrp;`mean;`;"";`turnover;1b;`v1);
        `metric`level`sourceTable`dependsOn`groupBy`aggExpr`weightCol`filterExpr`outputCol`enabled`version!
            (`turnover;`quarterly;`turnover_daily;`turnover;`year`quarter`topixCapGrp;`mean;`;"";`turnover;1b;`v1);
        `metric`level`sourceTable`dependsOn`groupBy`aggExpr`weightCol`filterExpr`outputCol`enabled`version!
            (`turnover;`period;`turnover_daily;`turnover;`topixCapGrp;`mean;`;"";`turnover;1b;`v1);

        `metric`level`sourceTable`dependsOn`groupBy`aggExpr`weightCol`filterExpr`outputCol`enabled`version!
            (`volume;`intraday;`trades_raw;`tradeSize;`date`timeBucket`sym`topixCapGrp;`sum;`;"";`volume;1b;`v1);
        `metric`level`sourceTable`dependsOn`groupBy`aggExpr`weightCol`filterExpr`outputCol`enabled`version!
            (`volume;`daily;`trades_raw;`tradeSize;`date`sym`topixCapGrp;`sum;`;"";`volume;1b;`v1);
