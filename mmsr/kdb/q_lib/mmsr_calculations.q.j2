{{ calculation_namespace }}.rollupFactsForScope:{[facts;metricName;scope]
    family: {{ calculation_namespace }}.metricRollupFamily metricName;
    if[family = `activity; :{{ calculation_namespace }}.rollupActivityFacts[facts;scope]];
    if[family = `pts_activity; :{{ calculation_namespace }}.rollupPtsActivityFacts[facts;scope]];
    if[family = `liquidity; :{{ calculation_namespace }}.rollupLiquidityFacts[facts;scope]];
    if[family = `volatility; :{{ calculation_namespace }}.rollupVolatilityFacts[facts;scope]];
    if[family = `reversion; :{{ calculation_namespace }}.rollupReversionFacts[facts;scope;metricName]];
    '": "sv string (`unsupportedRollupFamily;metricName;family)
    };

{{ calculation_namespace }}.labelRolledScope:{[facts;scope]
    if[scope = `market;
        rolled: update aggregationLevel:`market, groupType:`market, groupValue:`TSE from facts;
        if[`topixCapGrp in cols rolled; rolled: update topixCapGrp:`TSE from rolled];
        :rolled
        ];
    if[scope = `market_bucket;
        rolled: update aggregationLevel:`market_bucket, groupType:`market, groupValue:`TSE from facts;
        if[`topixCapGrp in cols rolled; rolled: update topixCapGrp:`TSE from rolled];
        :rolled
        ];
    if[scope = `topix_cap_group;
        :update aggregationLevel:`topix_cap_group, groupType:`topixCapGrp, groupValue:topixCapGrp from facts
        ];
    if[scope = `topix_cap_group_bucket;
        :update aggregationLevel:`topix_cap_group_bucket, groupType:`topixCapGrp, groupValue:topixCapGrp from facts
        ];
    if[scope = `symbol;
        :update aggregationLevel:`symbol, groupType:`sym, groupValue:sym from facts
        ];
    if[scope = `symbol_bucket;
        :update aggregationLevel:`symbol_bucket, groupType:`sym, groupValue:sym from facts
        ];
    if[scope = `venue;
        :update aggregationLevel:`venue, groupType:`venue, groupValue:venue from facts
        ];
    if[scope = `venue_bucket;
        :update aggregationLevel:`venue_bucket, groupType:`venue, groupValue:venue from facts
        ];
    if[scope = `venue_symbol;
        :update
            aggregationLevel:`venue_symbol,
            groupType: (count i) # enlist `venue`sym,
            groupValue: {x,y}'[venue;sym]
        from facts
        ];
    if[scope = `venue_symbol_bucket;
        :update
            aggregationLevel:`venue_symbol_bucket,
            groupType: (count i) # enlist `venue`sym,
            groupValue: {x,y}'[venue;sym]
        from facts
        ];
    if[scope = `venue_topix_cap_group;
        :update
            aggregationLevel:`venue_topix_cap_group,
            groupType: (count i) # enlist `venue`topixCapGrp,
            groupValue: {x,y}'[venue;topixCapGrp]
        from facts
        ];
    if[scope = `venue_topix_cap_group_bucket;
        :update
            aggregationLevel:`venue_topix_cap_group_bucket,
            groupType: (count i) # enlist `venue`topixCapGrp,
            groupValue: {x,y}'[venue;topixCapGrp]
        from facts
        ];
    '": "sv string (`unsupportedRollupScope;scope)
    };

{{ calculation_namespace }}.metricFactCanonicalCols:
    `date`timeBucket`aggregationLevel`groupType`groupValue`sym`venue`horizon`horizon_sort_order`positive_reversion_ratio`trade_count`notional`valid_primary_quote_ratio`metricValue;

{{ calculation_namespace }}.canonicalizeMetricFacts:{[facts;metricName]
    withMetricValue: $[metricName in cols facts; update metricValue: facts metricName from facts; facts];
    presentCols: {{ calculation_namespace }}.metricFactCanonicalCols inter cols withMetricValue;
    colData: (flip 0!withMetricValue) presentCols;
    0!flip presentCols!colData
    };

{{ calculation_namespace }}.rollupMetricResult:{[facts;metricName;aggregationLevels]
    if[0=count facts; :0!facts];
    mmsrFamily: {{ calculation_namespace }}.metricRollupFamily metricName;
    mmsrColumnNames: cols facts;
    mmsrHasBucket:`timeBucket in mmsrColumnNames;
    mmsrHasSym:`sym in mmsrColumnNames;
    mmsrHasCap:`topixCapGrp in mmsrColumnNames;
    mmsrHasVenue:`venue in mmsrColumnNames;
    dailyFacts: $[mmsrHasBucket; select from facts where timeBucket = `DAILY; facts];
    intradayFacts: $[mmsrHasBucket; select from facts where timeBucket <> `DAILY; 0#facts];
    mmsrRollups: ();
    if[(mmsrFamily <> `pts_activity) & (`market in aggregationLevels) & (0<count dailyFacts);
        mmsrRollups,:enlist {{ calculation_namespace }}.canonicalizeMetricFacts[
            {{ calculation_namespace }}.labelRolledScope[
                {{ calculation_namespace }}.rollupFactsForScope[dailyFacts;metricName;`market];
                `market];
            metricName]
        ];
    if[(mmsrFamily <> `pts_activity) & (`market_bucket in aggregationLevels) & (0<count intradayFacts);
        mmsrRollups,:enlist {{ calculation_namespace }}.canonicalizeMetricFacts[
            {{ calculation_namespace }}.labelRolledScope[
                {{ calculation_namespace }}.rollupFactsForScope[intradayFacts;metricName;`market_bucket];
                `market_bucket];
            metricName]
        ];
    if[(mmsrFamily <> `pts_activity) & (`topix_cap_group in aggregationLevels) & mmsrHasCap & (0<count dailyFacts);
        mmsrRollups,:enlist {{ calculation_namespace }}.canonicalizeMetricFacts[
            {{ calculation_namespace }}.labelRolledScope[
                {{ calculation_namespace }}.rollupFactsForScope[dailyFacts;metricName;`topix_cap_group];
                `topix_cap_group];
            metricName]
        ];
    if[(mmsrFamily <> `pts_activity) & (`topix_cap_group_bucket in aggregationLevels) & mmsrHasCap & (0<count intradayFacts);
        mmsrRollups,:enlist {{ calculation_namespace }}.canonicalizeMetricFacts[
            {{ calculation_namespace }}.labelRolledScope[
                {{ calculation_namespace }}.rollupFactsForScope[intradayFacts;metricName;`topix_cap_group_bucket];
                `topix_cap_group_bucket];
            metricName]
        ];
    if[(mmsrFamily <> `pts_activity) & (`symbol in aggregationLevels) & mmsrHasSym & (0<count dailyFacts);
        mmsrRollups,:enlist {{ calculation_namespace }}.canonicalizeMetricFacts[
            {{ calculation_namespace }}.labelRolledScope[
                {{ calculation_namespace }}.rollupFactsForScope[dailyFacts;metricName;`symbol];
                `symbol];
            metricName]
        ];
    if[(mmsrFamily <> `pts_activity) & (`symbol_bucket in aggregationLevels) & mmsrHasSym & (0<count intradayFacts);
        mmsrRollups,:enlist {{ calculation_namespace }}.canonicalizeMetricFacts[
            {{ calculation_namespace }}.labelRolledScope[
                {{ calculation_namespace }}.rollupFactsForScope[intradayFacts;metricName;`symbol_bucket];
                `symbol_bucket];
            metricName]
        ];
    if[(`venue in aggregationLevels) & mmsrHasVenue & (0<count dailyFacts);
        mmsrRollups,:enlist {{ calculation_namespace }}.canonicalizeMetricFacts[
            {{ calculation_namespace }}.labelRolledScope[
                {{ calculation_namespace }}.rollupFactsForScope[dailyFacts;metricName;`venue];
                `venue];
            metricName]
        ];
    if[(`venue_bucket in aggregationLevels) & mmsrHasVenue & (0<count intradayFacts);
        mmsrRollups,:enlist {{ calculation_namespace }}.canonicalizeMetricFacts[
            {{ calculation_namespace }}.labelRolledScope[
                {{ calculation_namespace }}.rollupFactsForScope[intradayFacts;metricName;`venue_bucket];
                `venue_bucket];
            metricName]
        ];
    if[(`venue_symbol in aggregationLevels) & mmsrHasVenue & mmsrHasSym & (0<count dailyFacts);
        mmsrRollups,:enlist {{ calculation_namespace }}.canonicalizeMetricFacts[
            {{ calculation_namespace }}.labelRolledScope[
                {{ calculation_namespace }}.rollupFactsForScope[dailyFacts;metricName;`venue_symbol];
                `venue_symbol];
            metricName]
        ];
    if[(`venue_symbol_bucket in aggregationLevels) & mmsrHasVenue & mmsrHasSym & (0<count intradayFacts);
        mmsrRollups,:enlist {{ calculation_namespace }}.canonicalizeMetricFacts[
            {{ calculation_namespace }}.labelRolledScope[
                {{ calculation_namespace }}.rollupFactsForScope[intradayFacts;metricName;`venue_symbol_bucket];
                `venue_symbol_bucket];
            metricName]
        ];
    if[(`venue_topix_cap_group in aggregationLevels) & mmsrHasVenue & mmsrHasCap & (0<count dailyFacts);
        mmsrRollups,:enlist {{ calculation_namespace }}.canonicalizeMetricFacts[
            {{ calculation_namespace }}.labelRolledScope[
                {{ calculation_namespace }}.rollupFactsForScope[dailyFacts;metricName;`venue_topix_cap_group];
                `venue_topix_cap_group];
            metricName]
        ];
    if[(`venue_topix_cap_group_bucket in aggregationLevels) & mmsrHasVenue & mmsrHasCap & (0<count intradayFacts);
        mmsrRollups,:enlist {{ calculation_namespace }}.canonicalizeMetricFacts[
            {{ calculation_namespace }}.labelRolledScope[
                {{ calculation_namespace }}.rollupFactsForScope[intradayFacts;metricName;`venue_topix_cap_group_bucket];
                `venue_topix_cap_group_bucket];
            metricName]
        ];
    if[0=count mmsrRollups; :0#(0!facts)];
    0!(uj/) mmsrRollups
    };

{{ calculation_namespace }}.preAggregateFacts:{[facts]
    / Reduce per-chunk row count before cross-chunk raze by aggregating
    / additive activity columns while preserving sym so later symbol rollups
    / remain available in the final unified day result.
    / Daily rows should not aggregate by timeBucket; intraday rows must.
    if[0=count facts; :0!facts];
    if[not `timeBucket in cols facts;
        :0!select sum turnover, sum volume, sum trade_count
            by date, sym, topixCapGrp
            from facts
        ];
    dailyFacts: select from facts where timeBucket = `DAILY;
    intradayFacts: select from facts where timeBucket <> `DAILY;
    slimmed: ();
    if[0<count intradayFacts;
        slimmed,: enlist 0!select sum turnover, sum volume, sum trade_count
            by date, timeBucket, sym, topixCapGrp
            from intradayFacts
        ];
    if[0<count dailyFacts;
        slimmed,: enlist update timeBucket:`DAILY from 0!select sum turnover, sum volume, sum trade_count
            by date, sym, topixCapGrp
            from dailyFacts
        ];
    if[0=count slimmed; :0#(0!facts)];
    0!(uj/) slimmed
    };

{{ calculation_namespace }}.calcActivity:{[runDate;rawTrades;refs;params]
    trades: rawTrades lj `date`sym xkey refs;
    result: select
        turnover: sum tradePrice * tradeSize,
        volume: sum tradeSize,
        trade_count: count i
    by date,
       timeBucket: {{ calculation_namespace }}.timeBucket[time; session; auction; params`bucket],
       sym,
       topixCapGrp
    from trades
    where date = runDate,
          tradePrice > 0,
          tradeSize > 0,
          not null sym;
    0!result
    };

{{ calculation_namespace }}.calcPtsTurnover:{[runDate;rawPtsTrades;refs;params]
    ptsTrades: rawPtsTrades lj `date`sym xkey refs;
    result: select
        pts_turnover: sum tradePrice * tradeSize
    by date,
       timeBucket: {{ calculation_namespace }}.timeBucket[time; session; auction; params`bucket],
       sym,
       topixCapGrp,
       venue
    from ptsTrades
    where date = runDate,
          tradePrice > 0,
          tradeSize > 0,
          not null venue,
          not null sym;
    0!result
    };

{{ calculation_namespace }}.calcLiquidity:{[runDate;rawQuotes;refs;params]
    intradaySpec: {{ calculation_namespace }}.metricAggSpecGet[`quoted_spread_bps;`intraday];
    quotes: rawQuotes lj refs;
    sortedQuotes:`date`sym`time xasc quotes;
    bucketStart: (params`bucket) xbar sortedQuotes`time;
    bucketEnd: bucketStart + params`bucket;
    quotesWithNext: update nextTime:next time by date,sym from sortedQuotes;
    quotesWeighted:
        update
            spread_bps: 10000 * (askPrice - bidPrice) % ((askPrice + bidPrice) % 2),
            depth_lots: (bidSize + askSize) % lotSize,
            effectiveEnd: ?[null nextTime; bucketEnd; ?[nextTime < bucketEnd; nextTime; bucketEnd]]
        from quotesWithNext;
    quotesWeighted: update quoteWeightMs: `long$((effectiveEnd - time) % 0D00:00:00.001) from quotesWeighted;
    quotesWeighted: update quoteWeightMs: ?[quoteWeightMs <= 0; 1; quoteWeightMs] from quotesWeighted;
    result: select
        / Spread is time-weighted within date,sym,cap, bucket using quote staleness duration.
        quoted_spread_bps: wavg[quoteWeightMs; spread_bps],
        top_of_book_depth: med depth_lots
    by date,
       timeBucket: {{ calculation_namespace }}.timeBucketContinuous[time; params`bucket],
       sym,
       topixCapGrp
    from quotesWeighted
    where date = runDate,
          bidPrice > 0,
          askPrice > bidPrice,
          lotSize > 0,
          not null sym;
    0!result
    };

{{ calculation_namespace }}.calcParkinsonVolatility:{[runDate;rawTrades;refs;params]
    intradaySpec: {{ calculation_namespace }}.metricAggSpecGet[`parkinson_volatility_bps;`intraday];
    minCount: {{ calculation_namespace }}.metricAggSpecMinCount[intradaySpec];
    trades: rawTrades lj refs;
    hasAuction:`auction in cols trades;
    result: select
        / Require at least 2 prints in-bucket; single-point buckets do not have
        / a meaningful intrabucket range volatility estimate.
        numberOfTrades: count i,
        parkinson_volatility_bps: 
            10000 * sqrt ((log ((max tradePrice) % (min tradePrice))) xexp 2) % (4 * log 2)
    by date,
       timeBucket: {{ calculation_namespace }}.timeBucketContinuous[time; params`bucket],
       sym,
       topixCapGrp
    from trades
    where date = runDate,
          {{ calculation_namespace }}.metricAggSpecApplyAuctionFilter[auction;hasAuction;intradaySpec;params],
          tradePrice > 0,
          not null sym;
    result: update parkinson_volatility_bps: ?[numberOfTrades < minCount; 0n; parkinson_volatility_bps] from result;
    0!result
    };

{{ calculation_namespace }}.prepareToxicityReversion:{[runDate;rawPtsTradeRows;rawPtsQuoteRows;rawPrimaryQuoteRows;refs;params]
    / Source functions in the day runner are expected to return one runDate.
    / The date predicates below are kept as defensive guards for direct
    / multi-day template calls, but production day execution should not depend on
    / them for performance.
    rawPtsTrades: rawPtsTradeRows lj refs;
    rawPtsQuotes: rawPtsQuoteRows lj refs;
    rawPrimaryQuotes: rawPrimaryQuoteRows lj refs;
    ptsTrades:
        select
            date,
            time,
            sym,
            topixCapGrp,
            session,
            auction,
            venue,
            tradePrice,
            tradeSize,
            notional: tradePrice * tradeSize
        from rawPtsTrades
        where date = runDate,
              ((0=count params`venues) | venue in params`venues),
              ((not params`exclude_auction) | auction = 0),
              tradeSize > 0,
              tradePrice > 0,
              not null venue,
              not null sym;
    ptsTrades: update sym1: {{ calculation_namespace }}.venueSymKey[sym;venue] from ptsTrades;
    ptsQuotes:
        select
            date,
            time,
            ptsQuoteTime: time,
            sym,
            venue,
            ptsMid: (bidPrice + askPrice) % 2
        from rawPtsQuotes
        where date = runDate,
              ((0=count params`venues) | venue in params`venues),
              bidPrice > 0,
              askPrice > bidPrice,
              not null venue,
              not null sym;
    ptsQuotes: update sym1: {{ calculation_namespace }}.venueSymKey[sym;venue] from ptsQuotes;
    primaryQuotes:
        select
            date,
            time,
            primaryQuoteTime: time,
            sym,
            bidPrice,
            askPrice,
            primaryMid: (bidPrice + askPrice) % 2
        from rawPrimaryQuotes
        where date = runDate,
              venue = params`primary_venue,
              bidPrice > 0,
              askPrice > bidPrice,
              not null sym;
    sortedPtsTrades: {{ calculation_namespace }}.partedSym[`sym1`time xasc ptsTrades];
    sortedPtsQuotes: {{ calculation_namespace }}.partedSym[`sym1`time xasc ptsQuotes];
    tradeWithPtsQuote:
        aj[
            `sym1`time;
            sortedPtsTrades;
            sortedPtsQuotes
        ];
    sortedTradeWithPtsQuote: {{ calculation_namespace }}.partedSym[`sym`time xasc tradeWithPtsQuote];
    sortedPrimaryQuotes: {{ calculation_namespace }}.partedSym[`sym`time xasc primaryQuotes];
    tradeWithPreMid:
        aj[
            `sym`time;
            sortedTradeWithPtsQuote;
            sortedPrimaryQuotes
        ];
    postQuotes:
        select
            date,
            horizonTime: time,
            postQuoteTime: time,
            sym,
            postMid: primaryMid
        from primaryQuotes;
    postQuotes: {{ calculation_namespace }}.partedSym[`sym`horizonTime xasc postQuotes];
    `tradeWithPreMid`postQuotes!(tradeWithPreMid;postQuotes)
    };

{{ calculation_namespace }}.calcToxicityReversionPrepared:{[tradeWithPreMid;postQuotes;params]
    tradeForHorizon:
        update
            aggressorSide: ?[tradePrice>ptsMid;1;?[tradePrice<ptsMid;-1;0]],
            horizonTime: (time + params`horizon),
            ptsQuoteAge: time - ptsQuoteTime,
            primaryQuoteAge: time - primaryQuoteTime
        from tradeWithPreMid;
    sortedTradeForHorizon: {{ calculation_namespace }}.partedSym[`sym`horizonTime xasc tradeForHorizon];
    sortedPostQuotes: {{ calculation_namespace }}.partedSym[`sym`horizonTime xasc postQuotes];
    tradeWithPostMid:
        aj[
            `sym`horizonTime;
            sortedTradeForHorizon;
            sortedPostQuotes
        ];
    scored:
        update
            reversion_bps: aggressorSide * 10000 * (postMid - primaryMid) % postMid,
            horizon_sort_order: params`horizon_sort_order,
            valid_primary_quote: (primaryQuoteAge <= params`max_primary_quote_age) &
                (horizonTime - postQuoteTime) <= params`max_primary_quote_age,
            valid_pts_quote: ptsQuoteAge <= params`max_pts_quote_age
        from tradeWithPostMid;
    result: select
        reversion_bps: wavg[notional; reversion_bps],
        horizon_sort_order: first horizon_sort_order,
        positive_reversion_ratio: avg reversion_bps > 0,
        trade_count: count i,
        notional: sum notional,
        valid_primary_quote_ratio: avg valid_primary_quote
    by date,
       timeBucket: {{ calculation_namespace }}.timeBucket[time; session; auction; params`bucket],
       venue,
       horizon: params`horizon_label,
       sym,
       topixCapGrp
    from scored
    where valid_primary_quote,
          valid_pts_quote,
          aggressorSide in 1 -1,
          not null ptsMid,
          not null primaryMid,
          not null postMid,
          postMid > 0;
    result: xcol[`date`timeBucket`venue`horizon`sym`topixCapGrp`reversion_bps`horizon_sort_order`positive_reversion_ratio`trade_count`notional`valid_primary_quote_ratio; result];
    result: @[cols result; where (cols result)=`reversion_bps; :; params`value_column] xcol result;
    0!result
    };

{{ calculation_namespace }}.calcToxicityReversion:{[runDate;rawPtsTradeRows;rawPtsQuoteRows;rawPrimaryQuoteRows;refs;params]
    prepared: {{ calculation_namespace }}.prepareToxicityReversion[
        runDate;
        rawPtsTradeRows;
        rawPtsQuoteRows;
        rawPrimaryQuoteRows;
        refs;
        params];
    {{ calculation_namespace }}.calcToxicityReversionPrepared[
        prepared`tradeWithPreMid;
        prepared`postQuotes;
        params]
    };

{{ calculation_namespace }}.calcToxicityReversionFamily:{[runDate;rawPtsTradeRows;rawPtsQuoteRows;rawPrimaryQuoteRows;refs;paramsByMetric;metricNames]
    if[0=count metricNames; :()!()];
    firstParams: paramsByMetric first metricNames;
    prepared: {{ calculation_namespace }}.prepareToxicityReversion[
        runDate;
        rawPtsTradeRows;
        rawPtsQuoteRows;
        rawPrimaryQuoteRows;
        refs;
        firstParams];
    sortedPostQuotes: prepared`postQuotes;
    metricNames!({[tradeWithPreMid;postQuotes;paramsByMetric;metricName]
        {{ calculation_namespace }}.calcToxicityReversionPrepared[
            tradeWithPreMid;
            postQuotes;
            paramsByMetric metricName]
        }[prepared`tradeWithPreMid;sortedPostQuotes;paramsByMetric] each metricNames)
    };

{{ calculation_namespace }}.applyUniverseFilters:{[refs;universeFilters]
    filteredRefs: refs;
    if[`symbols in key universeFilters;
        if[0<count universeFilters`symbols;
            filteredRefs: select from filteredRefs where sym in universeFilters`symbols
            ]
        ];
    filteredRefs
    };

{{ calculation_namespace }}.loadReportSources:{[runDate;refs;sourceFunctions]
    rawSources: enlist[`refs]!enlist refs;
    if[`trades in key sourceFunctions;
        rawSources[`trades]: sourceFunctions[`trades][runDate;0!refs]
        ];
    if[`quotes in key sourceFunctions;
        rawSources[`quotes]: sourceFunctions[`quotes][runDate;0!refs]
        ];
    if[`pts_trades in key sourceFunctions;
        rawSources[`pts_trades]: sourceFunctions[`pts_trades][runDate;0!refs]
        ];
    if[`pts_quotes in key sourceFunctions;
        rawSources[`pts_quotes]: sourceFunctions[`pts_quotes][runDate;0!refs]
        ];
    if[`primary_quotes in key sourceFunctions;
        rawSources[`primary_quotes]: sourceFunctions[`primary_quotes][runDate;0!refs]
        ];
    rawSources
    };

{{ calculation_namespace }}.isToxicityReversionMetric:{[metricName]
    string[metricName] like "primary_quote_reversion_*_bps"
    };

{{ calculation_namespace }}.elapsedMs:{[startTs;endTs]
    `long$((endTs - startTs) % 0D00:00:00.001)
    };

{{ calculation_namespace }}.metricFactLevel:{[facts]
    if[not `timeBucket in cols facts;
        :update level:`daily from facts
        ];
    update level: ?[(null timeBucket) | (timeBucket = `DAILY); `daily; `intraday] from facts
    };

{{ calculation_namespace }}.metricFactTable:{[facts;metricName;refLoadMs;chunkCalcMs;rollupMs;totalMs;chunkCount;symbolCount]
    enriched: update
        metricName: metricName,
        reportRefLoadMs: refLoadMs,
        reportChunkCalcMs: chunkCalcMs,
        reportRollupMs: rollupMs,
        reportTotalMs: totalMs,
        reportChunkCount: chunkCount,
        reportSymbolCount: symbolCount
    from facts;
    {{ calculation_namespace }}.metricFactLevel enriched
    };

{{ calculation_namespace }}.runReportDay:{[runDate;reportConfig]
    reportStartTs: .z.p;
    sourceFunctions: reportConfig`sourceFunctions;
    metricNames: reportConfig`metricNames;
    metricParams: reportConfig`metricParams;
    universeFilters: reportConfig`universeFilters;
    requestedAggregationLevels: reportConfig`aggregationLevels;
    metricAggregationLevel: $[`metricAggregationLevel in key reportConfig; reportConfig`metricAggregationLevel; `intraday];
    chunkSize: reportConfig`chunkSize;

    refLoadStartTs: .z.p;
    rawRefs: sourceFunctions[`reference_data][runDate];
    refs: `sym xkey {{ calculation_namespace }}.applyUniverseFilters[rawRefs;universeFilters];
    allSyms: exec sym from 0!refs;
    refLoadEndTs: .z.p;

    chunks: enlist 0#`;
    if[0<count allSyms; chunks: chunkSize cut allSyms];

    / Each chunk lambda returns (sourceLoadMs; regularCalcMs; reversionCalcMs; resultDict).
    chunkResults: { [runDate;refs;sourceFunctions;metricNames;metricParams;metricAggregationLevel;chunkSyms]
            chunkRefs: `sym xkey select from 0!refs where sym in chunkSyms;
            srcStart: .z.p;
            rawSources: {{ calculation_namespace }}.loadReportSources[runDate;chunkRefs;sourceFunctions];
            srcEnd: .z.p;
            reversionMetrics: metricNames where {{ calculation_namespace }}.isToxicityReversionMetric each metricNames;
            regularMetrics: metricNames where not {{ calculation_namespace }}.isToxicityReversionMetric each metricNames;
            resultDict: ()!();
            regularStart: .z.p;
            if[0<count regularMetrics;
                resultDict,: {{ calculation_namespace }}.runRegularMetricsBatched[
                    runDate;
                    rawSources;
                    metricParams;
                    regularMetrics;
                    metricAggregationLevel]
                ];
            regularEnd: .z.p;
            reversionStart: regularEnd;
            if[0<count reversionMetrics;
                resultDict,: {{ calculation_namespace }}.calcToxicityReversionFamily[
                    runDate;
                    rawSources`pts_trades;
                    rawSources`pts_quotes;
                    rawSources`primary_quotes;
                    rawSources`refs;
                    metricParams;
                    reversionMetrics]
                ];
            reversionEnd: .z.p;
            / Pre-aggregate activity-family results to shrink cross-chunk raze
            slimDict: metricNames!({[resultDict;metricName]
                    facts: resultDict[metricName];
                    $[{{ calculation_namespace }}.metricAggIsAdditiveMetric metricName;
                        {{ calculation_namespace }}.preAggregateFacts facts;
                        facts]
                    }[resultDict] each metricNames);
            ({{ calculation_namespace }}.elapsedMs[srcStart;srcEnd];
             {{ calculation_namespace }}.elapsedMs[regularStart;regularEnd];
             {{ calculation_namespace }}.elapsedMs[reversionStart;reversionEnd];
             slimDict)
        }[runDate;refs;sourceFunctions;metricNames;metricParams;metricAggregationLevel] each chunks;

    sourceLoadMs: sum {first x} each chunkResults;
    regularCalcMs: sum {x 1} each chunkResults;
    reversionCalcMs: sum {x 2} each chunkResults;
    metricCalcMs: regularCalcMs + reversionCalcMs;
    chunkCalcMs: sourceLoadMs + metricCalcMs;

    rollupStartTs: .z.p;
    rolledMetricDict: metricNames!({[chunkResults;requestedAggregationLevels;metricName]
            {{ calculation_namespace }}.rollupMetricResult[
                raze {[metricName;chunkResult] chunkResult[3][metricName]}[metricName] each chunkResults;
                metricName;
                requestedAggregationLevels]
            }[chunkResults;requestedAggregationLevels] each metricNames);
    rollupEndTs: .z.p;

    refLoadMs: {{ calculation_namespace }}.elapsedMs[refLoadStartTs;refLoadEndTs];
    rollupMs: {{ calculation_namespace }}.elapsedMs[rollupStartTs;rollupEndTs];
    totalMs: {{ calculation_namespace }}.elapsedMs[reportStartTs;rollupEndTs];
    chunkCount: count chunks;
    symbolCount: count allSyms;

    factTables: ({[rolledMetricDict;refLoadMs;chunkCalcMs;rollupMs;totalMs;chunkCount;symbolCount;metricName]
            {{ calculation_namespace }}.metricFactTable[
                rolledMetricDict[metricName];
                metricName;
                refLoadMs;
                chunkCalcMs;
                rollupMs;
                totalMs;
                chunkCount;
                symbolCount]
            }[rolledMetricDict;refLoadMs;chunkCalcMs;rollupMs;totalMs;chunkCount;symbolCount] each metricNames);
    unifiedResult: $[0=count factTables; (); 0!(uj/) factTables];
    
    if[`topixCapGrp in cols unifiedResult;
        unifiedResult: delete topixCapGrp from unifiedResult
        ];

    -1 "MMSR runReportDay ",string[runDate]," ref:",string[refLoadMs],"ms src:",string[sourceLoadMs],"ms calc_regular:",string[regularCalcMs],"ms calc_reversion:",string[reversionCalcMs],"ms calc_total:",string[metricCalcMs],"ms rollup:",string[rollupMs],"ms total:",string[totalMs],"ms chunks:",string[chunkCount]," syms:",string[symbolCount];
    unifiedResult
    };
