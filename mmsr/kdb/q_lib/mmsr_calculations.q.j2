{{ calculation_namespace }}.metricAggSpecGet:{[metricName;levelName]
    spec: select from {{ calculation_namespace }}.metricAggSpec where enabled, metric=metricName, level=levelName;
    if[0=count spec; '"missing metric agg spec row"];
    if[1<count spec; '"duplicate metric agg spec rows"];
    first spec
    };

{{ calculation_namespace }}.metricAggSpecHasFilter:{[spec;token]
    filterExpr: spec`filterExpr;
    if[0 = count filterExpr; :0b];
    token in `$ "|" vs filterExpr
    };

{{ calculation_namespace }}.metricAggSpecApplyAuctionFilter:{[auctionCol;hasAuction;spec;params]
    / If spec asks for auction exclusion, apply runtime exclude_auction flag.
    if[{{ calculation_namespace }}.metricAggSpecHasFilter[spec;`excludeAuctionIfPresent];
        :((not hasAuction) | (not params`exclude_auction) | auctionCol = 0)
        ];
    1b
    };

{{ calculation_namespace }}.metricAggSpecMinCount:{[spec]
    if[{{ calculation_namespace }}.metricAggSpecHasFilter[spec;`minCount2]; :2];
    1
    };

{{ calculation_namespace }}.metricAggSpecSourceKey:{[sourceTable]
    / Map spec source-table labels to rawSources dictionary keys.
    if[sourceTable in `trades_raw; :`trades];
    if[sourceTable in `quotes_raw; :`quotes];
    if[sourceTable in `pts_trades_raw; :`pts_trades];
    if[sourceTable in `pts_quotes_raw; :`pts_quotes];
    if[sourceTable in `primary_quotes_raw; :`primary_quotes];
    `unknown
    };

{{ calculation_namespace }}.metricAggSpecValidateDailyRaw:{[metric]
    dailySpec: {{ calculation_namespace }}.metricAggSpecGet[metric;`daily];
    if[not string[dailySpec`sourceTable] like "*_raw";
        '": "sv string (`invalidDailySpecSource;metric;dailySpec`sourceTable)
        ];
    1b
    };

{{ calculation_namespace }}.metricAggSpecCalcFamily:{[aggExpr]
    if[aggExpr in `sum; :`activity];
    if[aggExpr in `twap_quote_ms`median; :`liquidity];
    if[aggExpr = `parkinson_range; :`volatility];
    `unknown
    };

{{ calculation_namespace }}.metricAggIsAdditiveMetric:{[metricName]
    if[{{ calculation_namespace }}.isToxicityReversionMetric[metricName]; :0b];
    if[metricName = `pts_turnover; :0b];
    intradaySpec: {{ calculation_namespace }}.metricAggSpecGet[metricName;`intraday];
    (intradaySpec`aggExpr) in `sum
    };

{{ calculation_namespace }}.metricAggRunIntraday:{[runDate;metricName;rawSources;metricParams]
    intradaySpec: {{ calculation_namespace }}.metricAggSpecGet[metricName;`intraday];
    {{ calculation_namespace }}.metricAggSpecValidateDailyRaw[metricName];
    sourceKey: {{ calculation_namespace }}.metricAggSpecSourceKey[intradaySpec`sourceTable];
    calcFamily: {{ calculation_namespace }}.metricAggSpecCalcFamily[intradaySpec`aggExpr];
    if[sourceKey = `unknown;
        '": "sv string (`unknownSpecSource;metricName;intradaySpec`sourceTable)
        ];
    if[calcFamily = `unknown;
        '": "sv string (`unknownAggExpr;metricName;intradaySpec`aggExpr)
        ];
    if[not sourceKey in key rawSources;
        '": "sv string (`missingRawSource;metricName;sourceKey)
        ];
    if[metricName = `pts_turnover;
        :{{ calculation_namespace }}.calcPtsTurnover[runDate;rawSources[sourceKey];rawSources`refs;metricParams]
        ];
    if[calcFamily = `activity;
        :{{ calculation_namespace }}.calcActivity[runDate;rawSources[sourceKey];rawSources`refs;metricParams]
        ];
    if[calcFamily = `liquidity;
        :{{ calculation_namespace }}.calcLiquidity[runDate;rawSources[sourceKey];rawSources`refs;metricParams]
        ];
    if[calcFamily = `volatility;
        :{{ calculation_namespace }}.calcParkinsonVolatility[runDate;rawSources[sourceKey];rawSources`refs;metricParams]
        ];
    '": "sv string (`unsupportedMetric;metricName)
    };

{{ calculation_namespace }}.metricAggRunDailyRaw:{[runDate;metricName;rawSources;metricParams]
    dailySpec: {{ calculation_namespace }}.metricAggSpecGet[metricName;`daily];
    sourceKey: {{ calculation_namespace }}.metricAggSpecSourceKey[dailySpec`sourceTable];
    calcFamily: {{ calculation_namespace }}.metricAggSpecCalcFamily[dailySpec`aggExpr];
    if[sourceKey = `unknown;
        '": "sv string (`unknownSpecSource;metricName;dailySpec`sourceTable)
        ];
    if[calcFamily = `unknown;
        '": "sv string (`unknownAggExpr;metricName;dailySpec`aggExpr)
        ];
    if[not sourceKey in key rawSources;
        '": "sv string (`missingRawSource;metricName;sourceKey)
        ];
    if[metricName = `pts_turnover;
        rawPtsTrades: rawSources[sourceKey] lj `date`sym xkey rawSources`refs;
        :0!select
            pts_turnover: sum tradePrice * tradeSize
        by date,
           timeBucket: `DAILY,
           sym,
           topixCapGrp,
           venue
        from rawPtsTrades
        where date = runDate,
              tradePrice > 0,
              tradeSize > 0,
              not null venue,
              not null sym
        ];
    if[calcFamily = `activity;
        rawTrades: rawSources[sourceKey] lj `date`sym xkey rawSources`refs;
        :0!select
            turnover: sum tradePrice * tradeSize,
            volume: sum tradeSize,
            trade_count: count i
        by date,
           timeBucket: `DAILY,
           sym,
           topixCapGrp
        from rawTrades
        where date = runDate,
              tradePrice > 0,
              tradeSize > 0,
              not null sym
        ];
    if[calcFamily = `liquidity;
        rawQuotes: rawSources[sourceKey] lj rawSources`refs;
        sortedQuotes:`date`sym`time xasc rawQuotes;
        dayEnd: 0D24:00:00;
        quotesWithNext: update nextTime:next time by date,sym from sortedQuotes;
        quotesWeighted:
            update
                spread_bps: 10000 * (askPrice - bidPrice) % ((askPrice + bidPrice) % 2),
                depth_lots: (bidSize + askSize) % lotSize,
                effectiveEnd: ?[null nextTime; dayEnd; ?[nextTime < dayEnd; nextTime; dayEnd]]
            from quotesWithNext;
        quotesWeighted: update quoteWeightMs: `long$((effectiveEnd - time) % 0D00:00:00.001) from quotesWeighted;
        quotesWeighted: update quoteWeightMs: ?[quoteWeightMs <= 0; 1; quoteWeightMs] from quotesWeighted;
        :0!select
            quoted_spread_bps: wavg[quoteWeightMs; spread_bps],
            top_of_book_depth: med depth_lots
        by date,
           timeBucket: `DAILY,
           sym,
           topixCapGrp
        from quotesWeighted
        where date = runDate,
              bidPrice > 0,
              askPrice > bidPrice,
              lotSize > 0,
              not null sym
        ];
    if[calcFamily = `volatility;
        rawTrades: rawSources[sourceKey] lj `date`sym xkey rawSources`refs;
        hasAuction:`auction in cols rawTrades;
        minCount: {{ calculation_namespace }}.metricAggSpecMinCount[dailySpec];
        :0!update
            parkinson_volatility_bps: ?[numberOfTrades < minCount; 0n; parkinson_volatility_bps] from
        select
            numberOfTrades: count i,
            parkinson_volatility_bps: 
                10000 * sqrt ((log ((max tradePrice) % (min tradePrice))) xexp 2) % (4 * log 2)
        by date,
           timeBucket: `DAILY,
           sym,
           topixCapGrp
        from rawTrades
        where date = runDate,
              {{ calculation_namespace }}.metricAggSpecApplyAuctionFilter[auction;hasAuction;dailySpec;metricParams],
              tradePrice > 0,
              not null sym
        ];
    '": "sv string (`unsupportedMetric;metricName)
    };

{{ calculation_namespace }}.metricAggRunAtLevel:{[runDate;metricName;rawSources;metricParams;aggregationLevel]
    if[aggregationLevel = `daily;
        :{{ calculation_namespace }}.metricAggRunDailyRaw[runDate;metricName;rawSources;metricParams]
        ];
    if[aggregationLevel <> `intraday;
        '": "sv string (`unsupportedAggregationLevel;aggregationLevel)
        ];
    {{ calculation_namespace }}.metricAggRunIntraday[runDate;metricName;rawSources;metricParams]
    };

{{ calculation_namespace }}.metricAggExecutionKey:{[metricName;metricParams;aggregationLevel]
    level: $[aggregationLevel = `daily; `daily; `intraday];
    levelSpec: {{ calculation_namespace }}.metricAggSpecGet[metricName;level];
    sourceKey: {{ calculation_namespace }}.metricAggSpecSourceKey[levelSpec`sourceTable];
    calcFamily: {{ calculation_namespace }}.metricAggSpecCalcFamily[levelSpec`aggExpr];
    if[metricName = `pts_turnover; calcFamily: `pts_activity];
    paramsText: $[99h = type metricParams; .j.j metricParams; string metricParams];
    `$": "sv (string sourceKey; string calcFamily; string level; paramsText)
    };

{{ calculation_namespace }}.metricAggLevelForMetric:{[metricName;metricParamsByMetric;defaultLevel]
    metricParams: metricParamsByMetric metricName;
    if[`metric_aggregation_level in key metricParams;
        :metricParams`metric_aggregation_level
        ];
    if[`metricAggregationLevel in key metricParams;
        :metricParams`metricAggregationLevel
        ];
    defaultLevel
    };

{{ calculation_namespace }}.runRegularMetricsBatched:{[runDate;rawSources;metricParamsByMetric;regularMetrics;aggregationLevel]
    if[0=count regularMetrics; :()!()];
    metricKeyForMetricLevel:{[metricName;metricParamsByMetric;aggregationLevel]
        metricParams: metricParamsByMetric metricName;
        {{ calculation_namespace }}.metricAggExecutionKey[metricName;metricParams;aggregationLevel]
        };
    intradayKeys: metricKeyForMetricLevel[;metricParamsByMetric;`intraday] each regularMetrics;
    dailyKeys: metricKeyForMetricLevel[;metricParamsByMetric;`daily] each regularMetrics;
    metricKeys: distinct intradayKeys,dailyKeys;
    uniqueKeys: distinct metricKeys;
    baseForKey:{[keySym;runDate;rawSources;metricParamsByMetric;regularMetrics;intradayKeys;dailyKeys]
        idx: $[0<count where intradayKeys = keySym; first where intradayKeys = keySym; first where dailyKeys = keySym];
        metricName: regularMetrics idx;
        metricParams: metricParamsByMetric metricName;
        metricLevel: $[keySym in intradayKeys; `intraday; `daily];
        {{ calculation_namespace }}.metricAggRunAtLevel[runDate;metricName;rawSources;metricParams;metricLevel]
        };
    baseByKey: uniqueKeys! baseForKey[;runDate;rawSources;metricParamsByMetric;regularMetrics;intradayKeys;dailyKeys] each uniqueKeys;
    regularMetrics!({[idx;intradayKeys;dailyKeys;baseByKey]
            0!raze (baseByKey intradayKeys idx; baseByKey dailyKeys idx)
        }[;intradayKeys;dailyKeys;baseByKey] each til count regularMetrics)
    };

{{ calculation_namespace }}.timeBucket:{[t;session;auction;bucket]
    / Auction code 1=open, 2=close, 0=continuous.
    labels:{{ calculation_namespace }}.timeBucketContinuous[t; bucket];
    labels:@[labels;where (auction = 1) & (session = `am);:;`AMO];
    labels:@[labels;where (auction = 2) & (session = `am);:;`AMC];
    labels:@[labels;where (auction = 1) & (session = `pm);:;`PMO];
    labels:@[labels;where (auction = 2) & (session = `pm);:;`PMC];
    labels
    };

{{ calculation_namespace }}.timeBucketContinuous:{[t;bucket]
    `$string "u"$bucket xbar t
    };

{{ calculation_namespace }}.metricRollupFamily:{[metricName]
    if[metricName in `turnover`volume`trade_count; :`activity];
    if[metricName = `pts_turnover; :`pts_activity];
    if[metricName in `quoted_spread_bps`top_of_book_depth; :`liquidity];
    if[metricName = `parkinson_volatility_bps; :`volatility];
    if[{{ calculation_namespace }}.isToxicityReversionMetric metricName; :`reversion];
    `unknown
    };

{{ calculation_namespace }}.rollupActivityFacts:{[facts;scope]
    if[scope = `market; :0!select sum turnover, sum volume, sum trade_count by date from facts];
    if[scope = `market_bucket; :0!select sum turnover, sum volume, sum trade_count by date, timeBucket from facts];
    if[scope = `topix_cap_group; :0!select sum turnover, sum volume, sum trade_count by date, topixCapGrp from facts];
    if[scope = `topix_cap_group_bucket; :0!select sum turnover, sum volume, sum trade_count by date, timeBucket, topixCapGrp from facts];
    if[scope = `symbol; :0!select sum turnover, sum volume, sum trade_count by date, sym, topixCapGrp from facts];
    if[scope = `symbol_bucket; :0!select sum turnover, sum volume, sum trade_count by date, timeBucket, sym, topixCapGrp from facts];
    '": "sv string (`unsupportedRollupScope;scope)
    };

{{ calculation_namespace }}.rollupLiquidityFacts:{[facts;scope]
    if[scope = `market; :0!select quoted_spread_bps: avg quoted_spread_bps, top_of_book_depth: avg top_of_book_depth by date from facts];
    if[scope = `market_bucket; :0!select quoted_spread_bps: avg quoted_spread_bps, top_of_book_depth: avg top_of_book_depth by date, timeBucket from facts];
    if[scope = `topix_cap_group; :0!select quoted_spread_bps: avg quoted_spread_bps, top_of_book_depth: avg top_of_book_depth by date, topixCapGrp from facts];
    if[scope = `topix_cap_group_bucket; :0!select quoted_spread_bps: avg quoted_spread_bps, top_of_book_depth: avg top_of_book_depth by date, timeBucket, topixCapGrp from facts];
    if[scope = `symbol; :0!select quoted_spread_bps: avg quoted_spread_bps, top_of_book_depth: avg top_of_book_depth by date, sym, topixCapGrp from facts];
    if[scope = `symbol_bucket; :0!select quoted_spread_bps: avg quoted_spread_bps, top_of_book_depth: avg top_of_book_depth by date, timeBucket, sym, topixCapGrp from facts];
    '": "sv string (`unsupportedRollupScope;scope)
    };

{{ calculation_namespace }}.rollupVolatilityFacts:{[facts;scope]
    if[scope = `market; :0!select parkinson_volatility_bps: avg parkinson_volatility_bps by date from facts];
    if[scope = `market_bucket; :0!select parkinson_volatility_bps: avg parkinson_volatility_bps by date, timeBucket from facts];
    if[scope = `topix_cap_group; :0!select parkinson_volatility_bps: avg parkinson_volatility_bps by date, topixCapGrp from facts];
    if[scope = `topix_cap_group_bucket; :0!select parkinson_volatility_bps: avg parkinson_volatility_bps by date, timeBucket, topixCapGrp from facts];
    if[scope = `symbol; :0!select parkinson_volatility_bps: avg parkinson_volatility_bps by date, sym, topixCapGrp from facts];
    if[scope = `symbol_bucket; :0!select parkinson_volatility_bps: avg parkinson_volatility_bps by date, timeBucket, sym, topixCapGrp from facts];
    '": "sv string (`unsupportedRollupScope;scope)
    };

{{ calculation_namespace }}.rollupPtsActivityFacts:{[facts;scope]
    if[scope = `venue; :0!select sum pts_turnover by date, venue from facts];
    if[scope = `venue_bucket; :0!select sum pts_turnover by date, timeBucket, venue from facts];
    if[scope = `venue_symbol; :0!select sum pts_turnover by date, venue, sym, topixCapGrp from facts];
    if[scope = `venue_symbol_bucket; :0!select sum pts_turnover by date, timeBucket, venue, sym, topixCapGrp from facts];
    if[scope = `venue_topix_cap_group; :0!select sum pts_turnover by date, venue, topixCapGrp from facts];
    if[scope = `venue_topix_cap_group_bucket; :0!select sum pts_turnover by date, timeBucket, venue, topixCapGrp from facts];
    '": "sv string (`unsupportedRollupScope;scope)
    };

{{ calculation_namespace }}.rollupReversionFacts:{[facts;scope;metricName]
    factsWithMetric: update metricValue: facts metricName from facts;
    if[scope = `market;
        :0!select
            metricValue: avg metricValue,
            horizon_sort_order: first horizon_sort_order,
            positive_reversion_ratio: avg positive_reversion_ratio,
            trade_count: sum trade_count,
            notional: sum notional,
            valid_primary_quote_ratio: avg valid_primary_quote_ratio
